# Copy to .env.local (run `npm run setup` to do this and generate a secret).
# Never commit real values. In AWS, inject these from Secrets Manager / SSM.

# --- Required in production -------------------------------------------------
# 32+ random characters used to sign session cookies. Generate: openssl rand -base64 48
SESSION_SECRET=

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string (e.g. Amazon RDS). If unset, Cuework runs on an
# embedded PostgreSQL (PGlite) stored in CUEWORK_PGLITE_DIR — great for local
# dev and demos, NOT for production.
DATABASE_URL=
# TLS to PostgreSQL:  false (local)  |  true (encrypt, do NOT verify)  |  verify (encrypt + verify).
# Use "verify" on Amazon RDS: the container image ships the AWS RDS CA bundle at
# /app/certs/rds-global-bundle.pem (override with DATABASE_SSL_CA_FILE).
DATABASE_SSL=false
CUEWORK_PGLITE_DIR=.data/pglite

# --- Demo mode --------------------------------------------------------------
# true  = login page offers "Explore the demo workspace" (creates/uses the
#         clearly-labelled fictional Harborline workspace, no password needed).
# false = credentials only. Keep false for any deployment holding real data.
DEMO_MODE=true

# --- Deployment notes ---------------------------------------------------------
# Only set when testing a production build over plain http://localhost (cookies are Secure otherwise):
# INSECURE_COOKIES=true
# Running more than one instance? Set the same 32-byte base64 key on every instance so
# server-action payloads stay valid across them:  openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- AI recommendation agent ------------------------------------------------
# Cuework's rules engine finds leads; an AI agent then investigates each lead
# against the data and keeps, rewrites, or sets it aside. Without a model, you
# get the rules engine's results as they are. Two free ways to provide a model:
#
# 1) Local, private: Ollama (https://ollama.com) on a machine you control.
#      ollama pull qwen3:4b
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b
#
# 2) A hosted provider's free tier (fast, no hardware). Free tiers are rate
#    limited and may use the data you send, so by default only the fictional
#    demo workspace is sent; real workspaces use Ollama or the rules engine.
#    Get a key at https://console.groq.com/keys or https://aistudio.google.com/apikey
# CUEWORK_AI_PROVIDER=groq            # groq | gemini | openai-compatible
# GROQ_API_KEY=                       # or GEMINI_API_KEY=, or AI_API_KEY= for any provider
# AI_MODEL=                           # optional: override the preset model
# AI_BASE_URL=                        # required for openai-compatible
# CUEWORK_AI_HOSTED_FOR_ALL=false     # true = also send real workspaces' data to the provider
#
# Turn the agent off entirely:
# CUEWORK_AI_AGENT=off
